views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "Example dataset mapping/Strucke Data-mapping"
        - file.basename != "List of Strucke Entities"
    order:
      - status
      - file.name
      - Entity_Name
      - Public_ID
      - Type
      - extra_columns
      - SEAD_table
      - Target_Entity
      - Local_Keys
      - Remote_Keys
    sort: []
    columnSize:
      note.status: 105
  - type: cards
    name: View
